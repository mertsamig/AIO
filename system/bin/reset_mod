#!/system/bin/sh

# This script will completely remove the AIO module from your system.
# This is the safest way to revert all changes made by the module,
# including kernel-level tweaks applied via /sys and /proc.

echo "Uninstalling the AIO module..."

# Check if Magisk is in the path
if ! command -v magisk >/dev/null 2>&1; then
    echo "Error: 'magisk' command not found. This script must be run in a root shell where Magisk is accessible."
    exit 1
fi

magisk --remove-modules aio

echo " "
echo "AIO module has been scheduled for uninstallation."
echo "Please reboot your device for the changes to take effect."
echo "After rebooting, the module will be completely removed."