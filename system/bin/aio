#!/system/bin/sh

# Source the common functions
. /system/bin/aio_common.sh

# --- Tweak Functions ---

stop_loggers() {
    log_i "Stopping logging services..."
    services=(
        "aplogd" "charge_logger" "cnss_diag" "dumpstate" "idd-logreader"
        "idd-logreadermain" "ipacm-diag" "logcat" "logcatd" "logd" "ramdump"
        "stats" "statscompanion" "statsd" "subsystem_ramdump" "tcpdump"
        "tombstoned" "traced" "traced_probes" "vendor.cnss_diag"
        "vendor.ipacm-diag" "vendor.tcpdump" "wlan_logging" "miuibooster"
        "aee.log-1-1" "vendor_tcpdump" "emdlogger" "consyslogger"
        "mobile_log_d" "wifi_dump" "bt_dump" "cnss-daemon"
    )
    for service in "${services[@]}"; do
        stop_svc "$service" &
    done
    wait
    log_i "Logging services stopped."
}

apply_cpu_tweaks() {
    log_i "Applying CPU tweaks..."
    for cpu in /sys/devices/system/cpu/cpu*/cpufreq/; do
        if [ -d "$cpu" ]; then
            min_freq=$(cat "${cpu}cpuinfo_min_freq")
            max_freq=$(cat "${cpu}cpuinfo_max_freq")
            write "${cpu}scaling_min_freq" "$min_freq"
            write "${cpu}scaling_max_freq" "$max_freq"
            avail_govs=$(cat "${cpu}scaling_available_governors")
            for gov in sugov_ext schedutil; do
                if [[ "$avail_govs" == *"$gov"* ]]; then
                    write "${cpu}scaling_governor" "$gov"
                    if [ -d "${cpu}${gov}" ]; then
                        write "${cpu}${gov}/hispeed_freq" "4294967295"
                        write "${cpu}${gov}/hispeed_load" "90"
                        write "${cpu}${gov}/iowait_boost_enable" "1"
                        write "${cpu}${gov}/pl" "1"
                    fi
                    break
                fi
            done
        fi
    done

    write "/sys/devices/system/cpu/cpuidle/use_deepest_state" "1"
    log_i "CPU tweaks applied."
}

apply_gpu_tweaks() {
    log_i "Applying GPU tweaks..."
    local gpu="/sys/class/kgsl/kgsl-3d0/"
    if [ -d "$gpu" ]; then
        write "${gpu}bus_split" "1"
        write "${gpu}devfreq/adrenoboost" "0"
        write "${gpu}force_bus_on" "0"
        write "${gpu}force_clk_on" "0"
        write "${gpu}force_no_nap" "0"
        write "${gpu}force_rail_on" "0"
        write "${gpu}popp" "0"
        write "${gpu}pwrnap" "1"
        write "${gpu}thermal_pwrlevel" "0"
        write "${gpu}boost" "0"
        write "${gpu}cl_boost_disable" "0"
    fi

    write "/sys/module/simple_gpu_algorithm/parameters/simple_gpu_activate" "0"
    write "/sys/module/adreno_idler/parameters/adreno_idler_active" "N"
    log_i "GPU tweaks applied."
}

apply_io_tweaks() {
    log_i "Applying I/O tweaks..."
    for queue in /sys/block/*/queue/; do
        if [ -d "$queue" ]; then
            avail_scheds=$(cat "${queue}scheduler")
            for sched in none noop kyber bfq mq-deadline cfq; do
                if [[ "$avail_scheds" == *"$sched"* ]]; then
                    write "${queue}scheduler" "$sched"
                    break
                fi
            done
            write "${queue}add_random" "0"
        fi
    done
    log_i "I/O tweaks applied."
}

apply_network_tweaks() {
    log_i "Applying network tweaks..."
    local tcp_v4="/proc/sys/net/ipv4/"
    avail_cong=$(cat "${tcp_v4}tcp_available_congestion_control")
    for cong in bbr2 bbr c2tcp cdg westwood cubic; do
        if [[ "$avail_cong" == *"$cong"* ]]; then
            write "${tcp_v4}tcp_congestion_control" "$cong"
            break
        fi
    done

    write "${tcp_v4}ip_no_pmtu_disc" "0"
    write "${tcp_v4}tcp_ecn" "1"
    write "${tcp_v4}tcp_fastopen" "3"
    write "${tcp_v4}tcp_mtu_probing" "1"
    write "${tcp_v4}tcp_sack" "1"
    write "${tcp_v4}tcp_slow_start_after_idle" "0"
    write "${tcp_v4}tcp_timestamps" "1"
    write "${tcp_v4}tcp_tw_reuse" "1"
    write "${tcp_v4}tcp_window_scaling" "1"
    write "/proc/sys/net/core/netdev_max_backlog" "65536"
    log_i "Network tweaks applied."
}

apply_vm_lmk_tweaks() {
    log_i "Applying VM/LMK tweaks..."
    local vm="/proc/sys/vm/"
    local mm="/sys/kernel/mm/"
    local lmk="/sys/module/lowmemorykiller/parameters/"

    write "${lmk}enable_adaptive_lmk" "0"
    write "${lmk}lmk_fast_run" "0"
    write "${lmk}oom_reaper" "1"
    write "${vm}block_dump" "0"
    write "${vm}dirty_background_ratio" "10"
    write "${vm}dirty_ratio" "30"
    write "${vm}laptop_mode" "0"
    write "${vm}oom_dump_tasks" "0"
    write "${vm}overcommit_memory" "1"
    write "${vm}overcommit_ratio" "100"
    write "${vm}reap_mem_on_sigkill" "1"
    write "${vm}swappiness" "40"
    write "${mm}lru_gen/enabled" "Y"
    write "${mm}lru_gen/min_ttl_ms" "1000"
    write "${mm}swap/vma_ra_enabled" "true"
    write "/sys/module/process_reclaim/parameters/enable_process_reclaim" "0"
    write "${vm}compact_unevictable_allowed" "0"
    write "${vm}compaction_proactiveness" "0"
    log_i "VM/LMK tweaks applied."
}

apply_scheduler_tweaks() {
    log_i "Applying scheduler tweaks..."
    local kernel="/proc/sys/kernel/"
    write "${kernel}hung_task_timeout_secs" "0"
    write "${kernel}perf_cpu_time_max_percent" "5"
    write "${kernel}sched_autogroup_enabled" "1"
    write "${kernel}sched_boost" "0"
    write "${kernel}sched_boost_top_app" "1"
    write "${kernel}sched_child_runs_first" "0"
    write "${kernel}sched_conservative_pl" "1"
    write "${kernel}sched_cstate_aware" "1"
    write "${kernel}sched_energy_aware" "1"
    write "${kernel}sched_init_task_load" "20"
    write "${kernel}sched_initial_task_util" "0"
    write "${kernel}sched_migration_fixup" "0"
    write "${kernel}sched_min_task_util_for_boost" "0"
    write "${kernel}sched_min_task_util_for_colocation" "0"
    write "${kernel}sched_prefer_sync_wakee_to_waker" "1"
    write "${kernel}sched_tunable_scaling" "0"
    write "${kernel}sched_walt_rotate_big_tasks" "1"
    write "${kernel}timer_migration" "1"
    write "/proc/sys/dev/tty/ldisc_autoload" "0"
    write "/sys/devices/system/cpu/cpufreq/hotplug/cpu_hotplug_disable" "1"
    write "/sys/devices/system/cpu/sched/hint_enable" "0"
    write "/sys/devices/system/cpu/eas/enable" "1"
    write "/sys/kernel/debug/msm_vidc/disable_thermal_mitigation" "0"
    log_i "Scheduler tweaks applied."
}

apply_misc_tweaks() {
    log_i "Applying miscellaneous tweaks..."
    write "/sys/module/workqueue/parameters/power_efficient" "Y"
    write "/sys/kernel/fast_charge/force_fast_charge" "1"
    write "/sys/module/battery_saver/parameters/enabled" "N"
    write "/sys/module/pm2/parameters/idle_sleep_mode" "Y"
    write "/sys/module/msm_performance/parameters/touchboost" "0"
    write "/sys/power/pnpmgr/long_duration_touch_boost" "0"
    write "/sys/power/pnpmgr/touch_boost" "0"
    write "/proc/touch_boost/enable" "0"
    write "/proc/touch_boost/boost_duration" "0"
    write "/sys/kernel/fp_boost/enabled" "0"
    write "/sys/module/cryptomgr/parameters/notests" "Y"
    write "/sys/module/mmc_core/parameters/removable" "N"
    write "/sys/module/mmc_core/parameters/use_spi_crc" "N"
    write "/sys/kernel/dyn_fsync/Dyn_fsync_active" "Y"
    write "/proc/sys/fs/lease-break-time" "10"
    write "/proc/sys/fs/leases-enable" "1"
    log_i "Miscellaneous tweaks applied."
}

disable_debugging() {
    log_i "Disabling debugging..."
    useless=(
        "debug" "compat-log" "debug_level" "debug_mask" "debug_mode"
        "edac_mc_log" "enable_event_log" "enable_ramdumps" "log_ce"
        "log_ecn_error" "log_enabled" "log_level" "log_ue" "mballoc_debug"
        "seclog" "snapshot_crashdumper" "tracing_on"
    )
    for keyword in "${useless[@]}"; do
        for file in $(find /sys/ -type f -name "$keyword"); do
            write "$file" "0"
        done
    done
    write "/proc/sys/kernel/compat-log" "0"
    write "/proc/sys/kernel/panic" "0"
    write "/proc/sys/kernel/panic_on_oops" "0"
    write "/proc/sys/kernel/printk" "0 0 0 0"
    write "/proc/sys/kernel/softlockup_panic" "0"
    write "/proc/sys/vm/panic_on_oom" "0"
    write "/proc/sys/debug/exception-trace" "0"
    write "/sys/kernel/debug/debug_enabled" "0"
    write "/sys/kernel/debug/dri/0/debug/enable" "0"
    write "/sys/kernel/debug/rpm_log" "0"
    write "/sys/kernel/debug/sde_rotator0/clk_always_on" "0"
    write "/sys/kernel/debug/sde_rotator0/evtlog/enable" "0"
    write "/sys/kernel/printk_mode/printk_mode" "0"
    write "/sys/module/bluetooth/parameters/disable_ertm" "Y"
    write "/sys/module/bluetooth/parameters/disable_esco" "Y"
    write "/sys/module/dwc3/parameters/ep_addr_rxdbg_mask" "0"
    write "/sys/module/dwc3/parameters/ep_addr_txdbg_mask" "0"
    write "/sys/module/hid_apple/parameters/fnmode" "0"
    write "/sys/module/hid_magicmouse/parameters/emulate_3button" "N"
    write "/sys/module/hid_magicmouse/parameters/emulate_scroll_wheel" "N"
    write "/sys/module/logger/parameters/log_mode" "2"
    write "/sys/module/mdss_fb/parameters/backlight_dimmer" "N"
    write "/sys/module/otg_wakelock/parameters/enabled" "N"
    write "/sys/module/printk/parameters/console_suspend" "Y"
    write "/sys/module/service_locator/parameters/enable" "0"
    write "/sys/module/spurious/parameters/noirqdebug" "Y"
    log_i "Debugging disabled."
}

run_dexopt() {
    log_i "Starting background optimization..."
    cmd package bg-dexopt-job
    log_i "Background optimization task executed."
}

# --- Main Script ---

klog="/storage/emulated/0/aio/aio.log"
kdbg="/storage/emulated/0/aio/aio_dbg.log"

rm -f "$kdbg" "$klog"
: > "$kdbg"
: > "$klog"

log_i "Initializing AIO tweaks..."

# Source the configuration file
MODDIR=\${0%/*}
if [ -f "$MODDIR/aio.conf" ]; then
    log_i "Loading configuration from $MODDIR/aio.conf"
    . "$MODDIR/aio.conf"
else
    log_i "Configuration file not found. Using default settings."
fi

init_time=$(date +%s)

# Run tasks based on configuration
run_dexopt &

if [ "$DISABLE_LOGGING_SERVICES" = true ]; then
    stop_loggers &
fi
if [ "$ENABLE_CPU_TWEAKS" = true ]; then
    apply_cpu_tweaks
fi
if [ "$ENABLE_GPU_TWEAKS" = true ]; then
    apply_gpu_tweaks
fi
if [ "$ENABLE_IO_TWEAKS" = true ]; then
    apply_io_tweaks
fi
if [ "$ENABLE_NETWORK_TWEAKS" = true ]; then
    apply_network_tweaks
fi
if [ "$ENABLE_VM_LMK_TWEAKS" = true ]; then
    apply_vm_lmk_tweaks
fi
if [ "$ENABLE_SCHEDULER_TWEAKS" = true ]; then
    apply_scheduler_tweaks
fi
if [ "$ENABLE_MISC_TWEAKS" = true ]; then
    apply_misc_tweaks
fi
if [ "$DISABLE_DEBUGGING" = true ]; then
    disable_debugging
fi

wait
log_i "All enabled tweaks have been applied."
exit_time=$(date +%s)
exec_time=$((exit_time - init_time))
log_i "Total execution time: $exec_time seconds."
exit 0
