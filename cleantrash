#!/system/bin/sh

# cleantrash: Removes temporary files, caches, and tracking data

clean() {
    for path in "$@"; do
        if [ -e "$path" ]; then
            rm -rf "$path" >/dev/null 2>&1
        fi
    done
}

# --- System Caches & Logs ---
clean \
    /cache/* \
    /data/cache/* \
    /data/*.log \
    /data/anr/* \
    /data/backup/pending/* \
    /data/local/tmp/* \
    /data/mlog/* \
    /data/system/dropbox/* \
    /data/tombstones/* \
    /data/vendor/wlan_logs/*

# --- App Caches ---
clean \
    /data/data/*/cache \
    /data/user/0/*/cache \
    /data/user_de/0/*/cache \
    /data/media/0/Android/data/*/cache/*

# --- Tracking & Analytics Prefs ---
clean \
    /data/*/*/shared_prefs/com.crashlytics.prefs.xml \
    /data/*/*/shared_prefs/com.google.android.gms.measurement.prefs.xml \
    /data/*/*/shared_prefs/com.google.android.gms.analytics.prefs.xml \
    /data/*/*/shared_prefs/com.google.firebase.crashlytics.xml \
    /data/*/*/shared_prefs/admob.xml \
    /data/*/*/shared_prefs/FBAdPrefs.xml \
    /data/*/*/shared_prefs/crash_report.xml \
    /data/*/*/shared_prefs/analyticsprefs.xml

# --- Media & Bloat Junk ---
clean \
    /data/media/0/LOST.DIR \
    /data/media/0/found000 \
    /data/media/0/LazyList \
    /data/media/0/albumthumbs \
    /data/media/0/kunlun \
    /data/media/0/.CacheOfEUI \
    /data/media/0/.bstats \
    /data/media/0/.taobao \
    /data/media/0/MIUI/debug_log \
    /data/media/0/ramdump \
    /data/media/0/UnityAdsVideoCache \
    /data/media/0/*.CHK \
    /data/media/0/duilite \
    /data/media/0/DkMiBrowserDemo \
    /data/media/0/.xlDownload

# --- Specific App Junk ---
clean \
    /data/data/com.whatsapp/files/Logs/whatsapp.log \
    /data/data/com.myinsta.android/app_analytics/*

sync
echo "Trash cleaned."
