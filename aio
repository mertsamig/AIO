#!/system/bin/sh

klog="/storage/emulated/0/aio/aio.log"
kdbg="/storage/emulated/0/aio/aio_dbg.log"

# Ensure log directory exists
mkdir -p /storage/emulated/0/aio/
rm -f "$kdbg" "$klog"
: > "$kdbg"
: > "$klog"

log_i() {
    echo "[$(date +%T)]: [*] $1" >> "$klog"
}

log_d() {
    echo "[$(date +%T)]: $1" >> "$kdbg"
}

log_e() {
    echo "[$(date +%T)]: [!] $1" >> "$kdbg"
}

write() {
    local file="$1"
    local value="$2"
    [[ ! -f "$file" ]] && return 1
    
    if [[ ! -w "$file" ]]; then
        chmod +w "$file" 2>/dev/null || return 1
    fi
    
    local curval=$(cat "$file" 2>/dev/null)
    [[ "$curval" == "$value" ]] && {
        log_d "$file already set to $value"
        return 0
    }
    
    echo -n "$value" > "$file" 2>/dev/null || {
        log_e "Failed to write $value to $file"
        return 1
    }
    
    log_d "$file: $curval -> $value"
}

# Paths
kernel="/proc/sys/kernel/"
tcp_v4="/proc/sys/net/ipv4/"
vm="/proc/sys/vm/"
mm="/sys/kernel/mm/"
gpu="/sys/class/kgsl/kgsl-3d0/"
stune="/dev/stune/"

# Hardware detection
PLATFORM=$(getprop ro.board.platform)
IS_QCOM=0
IS_MTK=0
case "$PLATFORM" in
    msm*|sdm*|sm*|lahaina|taro|cape|diwali) IS_QCOM=1 ;;
    mt*|mediatek*) IS_MTK=1 ;;
esac

stop_services() {
    # Disable heavy debug and logging services to free up resources.
    # These services are often used for diagnostics and consume background CPU/RAM.
    services="aplogd charge_logger cnss_diag dumpstate idd-logreader idd-logreadermain ipacm-diag logcat logcatd logd ramdump stats statscompanion statsd subsystem_ramdump tcpdump tombstoned traced traced_probes vendor.cnss_diag vendor.ipacm-diag vendor.tcpdump wlan_logging miuibooster aee.log-1-1 vendor_tcpdump emdlogger consyslogger mobile_log_d wifi_dump bt_dump cnss-daemon"

    for service in $services; do
        stop "$service" >/dev/null 2>&1
        setprop "ctl.stop" "$service"
    done
    log_i "Disabled debug services and daemons"
}

boost_tune() {
    # CPU boost mechanisms are generally disabled to save power,
    # relying on the efficiency of modern schedulers (PELT/WALT).
    write "${kernel}launcher_boost_enabled" "0"
    write "${kernel}slide_boost_enabled" "0"

    log_i "Tuned CPU boost mechanisms (Balanced)"
}

io_tune() {
    # Optimize I/O scheduler and queue parameters for better throughput and lower latency.
    for queue in /sys/block/*/queue/; do
        [ ! -d "$queue" ] && continue
        avail_scheds=$(cat "${queue}scheduler" 2>/dev/null)

        # Prefer modern multiqueue schedulers.
        # mq-deadline is often best for flash storage.
        for sched in mq-deadline kyber bfq none; do
            if echo "$avail_scheds" | grep -q "$sched"; then
                write "${queue}scheduler" "$sched"
                break
            fi
        done

        write "${queue}add_random" "0" # Disable entropy contribution to save CPU cycles.
        write "${queue}iostats" "0"    # Disable I/O statistics gathering to reduce overhead.
        write "${queue}nr_requests" "128" # Balanced value for queue depth.

        # bfq tunables: enable low latency mode for better UI responsiveness when under I/O load.
        [ -f "${queue}iosched/low_latency" ] && write "${queue}iosched/low_latency" "1"
    done
    log_i "Tweaked I/O parameters (Balanced)"
}

cpu_tune() {
    # Uclamp (Utilization Clamping): Improves responsiveness by setting a minimum utilization
    # for tasks in the 'top-app' group, ensuring they get scheduled on capable CPUs.
    if [ -d "/dev/cpuctl/top-app" ]; then
        write "/dev/cpuctl/top-app/cpu.uclamp.min" "1"
        write "/dev/cpuctl/top-app/cpu.uclamp.latency_sensitive" "1"
    fi

    # Scheduler migration thresholds:
    # upmigrate (default ~95): threshold for migrating task to a more powerful CPU. Lower = more aggressive.
    # downmigrate (default ~85): threshold for migrating task to a less powerful CPU. Lower = more aggressive.
    # Setting these to slightly lower than default (90/75) improves responsiveness.
    write "${kernel}sched_upmigrate" "90"
    write "${kernel}sched_downmigrate" "75"

    # Platform specific CPU tuning
    if [ "$IS_MTK" = "1" ]; then
        # MediaTek FPSGO: specific optimization for MTK platforms.
        write "/sys/kernel/fpsgo/common/fpsgo_enable" "1"
    fi

    # Set CPU governor to 'schedutil' if available (the modern default for Android).
    for cpu in /sys/devices/system/cpu/cpu*/cpufreq/; do
        [ ! -d "$cpu" ] && continue
        avail_govs=$(cat "${cpu}scaling_available_governors" 2>/dev/null)
        for gov in schedutil sugov_ext interactive; do
            if echo "$avail_govs" | grep -q "$gov"; then
                write "${cpu}scaling_governor" "$gov"
                break
            fi
        done
    done
    log_i "Tweaked CPU governor (Balanced)"
}

gpu_tune() {
    # Qualcomm Adreno GPU tweaks:
    # adrenoboost can improve FPS in games but increases power usage.
    if [ "$IS_QCOM" = "1" ] && [ -d "$gpu" ]; then
        write "${gpu}devfreq/adrenoboost" "0"
        write "${gpu}throttling" "1"
        log_i "Tweaked Adreno GPU parameters (Balanced)"
    fi
}

schedtune_tune() {
    # Schedtune: Task placement and boosting via Energy Aware Scheduling (EAS).
    # Small boosts for foreground and top-app tasks improve perceived smoothness.
    if [ -d "$stune" ]; then
        write "${stune}foreground/schedtune.boost" "1"
        write "${stune}top-app/schedtune.boost" "1"
        log_i "Tweaked Schedtune settings (Balanced)"
    fi
}

vm_lmk_tune() {
    # Virtual Memory and LMK tuning for better memory management and reduced lag.
    write "${vm}dirty_ratio" "20"
    write "${vm}dirty_background_ratio" "5"
    write "${vm}vfs_cache_pressure" "100" # Balanced pressure on VFS cache.
    write "${vm}overcommit_memory" "0"     # Use standard Android memory overcommit policy.
    write "${vm}page-cluster" "0"          # Reduce read-ahead on swap to optimize for ZRAM latency.
    write "${vm}swappiness" "60"           # Balanced swap priority.

    # MGLRU (Multi-Gen LRU): Greatly improves memory management by identifying "hot" pages more accurately.
    if [ -e "${mm}lru_gen/enabled" ]; then
        write "${mm}lru_gen/enabled" "Y"
    fi

    # Disable proactive compaction to reduce background CPU jitter.
    write "${vm}compaction_proactiveness" "0"

    # Transparent Hugepages (THP): Disabled to save RAM, as it can cause significant internal fragmentation.
    if [ -e "/sys/kernel/mm/transparent_hugepage/enabled" ]; then
        write "/sys/kernel/mm/transparent_hugepage/enabled" "never"
    fi

    # Watermark tuning:
    # Disabling watermark boost reduces kswapd wakeups, saving power and reducing jitter.
    write "${vm}watermark_boost_factor" "0"
    # watermark_scale_factor: Increase to start background reclaim earlier, avoiding "direct reclaim" lag.
    write "${vm}watermark_scale_factor" "100"

    # ZRAM optimization: Select the best available compression algorithm for swap performance.
    if [ -d "/sys/block/zram0" ]; then
        avail_algos=$(cat /sys/block/zram0/comp_algorithm 2>/dev/null)
        for algo in zstd lz4 lzo-rle lzo; do
            if echo "$avail_algos" | grep -q "$algo"; then
                write "/sys/block/zram0/comp_algorithm" "$algo"
                break
            fi
        done
    fi

    # KSM (Kernel Samepage Merging): Enable to save RAM by merging identical pages.
    if [ -e "/sys/kernel/mm/ksm/run" ]; then
        write "/sys/kernel/mm/ksm/run" "1"
    fi

    log_i "Tweaked VM and LMK parameters (Balanced)"
}

config_tcp() {
    # Networking: Choose the best available congestion control algorithm (BBR/BBR2 preferred).
    avail_con=$(cat "${tcp_v4}tcp_available_congestion_control" 2>/dev/null)
    for con in bbr bbr2 westwood cubic; do
        if echo "$avail_con" | grep -q "$con"; then
            write "${tcp_v4}tcp_congestion_control" "$con"
            break
        fi
    done

    write "${tcp_v4}tcp_fastopen" "3"           # Enable TCP Fast Open for both client and server.
    write "${tcp_v4}tcp_slow_start_after_idle" "0" # Keep congestion window after idle.
    log_i "Applied TCP tweaks"
}

pewq() {
    # Power Efficient Workqueue: Improves battery life by allowing workqueues to be power-aware.
    if [ -e "/sys/module/workqueue/parameters/power_efficient" ]; then
        write "/sys/module/workqueue/parameters/power_efficient" "Y"
        log_i "Tuned power efficient workqueue (Balanced)"
    fi
}

disable_debug() {
    # Disable kernel logging and various tracers to reduce system overhead and improve security.
    write "${kernel}printk" "0 0 0 0"

    # Disable scheduler statistics and tracing.
    write "${kernel}sched_schedstats" "0"
    write "/sys/kernel/debug/tracing/tracing_on" "0"

    log_i "Disabled various debugging features"
}

# Main execution
log_i "Applying AIO tweaks (Balanced)"
sync

stop_services
boost_tune
io_tune
cpu_tune
gpu_tune
schedtune_tune
vm_lmk_tune
config_tcp
disable_debug
pewq

log_i "AIO tweaks application completed."
