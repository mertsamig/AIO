#!/system/bin/sh

# MOD_PROFILE: balance, performance, battery
MOD_PROFILE="balance"

klog="/storage/emulated/0/aio/aio.log"
kdbg="/storage/emulated/0/aio/aio_dbg.log"

# Ensure log directory exists
mkdir -p /storage/emulated/0/aio/
rm -f "$kdbg" "$klog"
: > "$kdbg"
: > "$klog"

log_i() {
    echo "[$(date +%T)]: [*] $1" >> "$klog"
}

log_d() {
    echo "[$(date +%T)]: $1" >> "$kdbg"
}

log_e() {
    echo "[$(date +%T)]: [!] $1" >> "$kdbg"
}

write() {
    local file="$1"
    local value="$2"
    [[ ! -f "$file" ]] && return 1
    
    if [[ ! -w "$file" ]]; then
        chmod +w "$file" 2>/dev/null || return 1
    fi
    
    local curval=$(cat "$file" 2>/dev/null)
    [[ "$curval" == "$value" ]] && {
        log_d "$file already set to $value"
        return 0
    }
    
    echo -n "$value" > "$file" 2>/dev/null || {
        log_e "Failed to write $value to $file"
        return 1
    }
    
    log_d "$file: $curval -> $value"
}

# Paths
kernel="/proc/sys/kernel/"
tcp_v4="/proc/sys/net/ipv4/"
vm="/proc/sys/vm/"
mm="/sys/kernel/mm/"
gpu="/sys/class/kgsl/kgsl-3d0/"
stune="/dev/stune/"

# Hardware detection
PLATFORM=$(getprop ro.board.platform)
IS_QCOM=0
IS_MTK=0
case "$PLATFORM" in
    msm*|sdm*|sm*|lahaina|taro|cape|diwali) IS_QCOM=1 ;;
    mt*|mediatek*) IS_MTK=1 ;;
esac

stop_services() {
    # Disable heavy debug and logging services to free up resources
    services="aplogd charge_logger cnss_diag dumpstate idd-logreader idd-logreadermain ipacm-diag logcat logcatd logd ramdump stats statscompanion statsd subsystem_ramdump tcpdump tombstoned traced traced_probes vendor.cnss_diag vendor.ipacm-diag vendor.tcpdump wlan_logging miuibooster"

    for service in $services; do
        stop "$service" >/dev/null 2>&1
        setprop "ctl.stop" "$service"
    done
    log_i "Disabled debug services and daemons"
}

boost_tune() {
    # Tune or disable various boost mechanisms based on profile
    local b_val="0"
    [ "$MOD_PROFILE" = "performance" ] && b_val="1"

    # Qualcomm CPU Boost (CAF)
    if [ "$IS_QCOM" = "1" ]; then
        if [ "$MOD_PROFILE" = "performance" ]; then
            write "/sys/module/cpu_boost/parameters/input_boost_ms" "40"
        else
            write "/sys/module/cpu_boost/parameters/input_boost_ms" "0"
        fi
        write "/sys/module/cpu_boost/parameters/sched_boost_on_input" "$b_val"
    fi

    write "${kernel}launcher_boost_enabled" "$b_val"
    write "${kernel}slide_boost_enabled" "$b_val"

    log_i "Tuned CPU boost mechanisms ($MOD_PROFILE)"
}

io_tune() {
    # Optimize I/O scheduler and queue parameters for better throughput
    for queue in /sys/block/*/queue/; do
        [ ! -d "$queue" ] && continue
        avail_scheds=$(cat "${queue}scheduler" 2>/dev/null)

        # Prefer modern schedulers
        for sched in mq-deadline kyber bfq none; do
            if echo "$avail_scheds" | grep -q "$sched"; then
                write "${queue}scheduler" "$sched"
                break
            fi
        done

        write "${queue}add_random" "0" # Disable entropy contribution (saves CPU)
        write "${queue}iostats" "0"    # Disable I/O statistics gathering

        if [ "$MOD_PROFILE" = "performance" ]; then
            write "${queue}nr_requests" "256"
        else
            write "${queue}nr_requests" "128"
        fi
    done
    log_i "Tweaked I/O parameters ($MOD_PROFILE)"
}

cpu_tune() {
    # Scheduler migration thresholds:
    # upmigrate: threshold for migrating task to a more powerful CPU
    # downmigrate: threshold for migrating task to a less powerful CPU
    if [ "$MOD_PROFILE" = "performance" ]; then
        write "${kernel}sched_upmigrate" "85"
        write "${kernel}sched_downmigrate" "65"
    elif [ "$MOD_PROFILE" = "battery" ]; then
        write "${kernel}sched_upmigrate" "95"
        write "${kernel}sched_downmigrate" "85"
    else
        write "${kernel}sched_upmigrate" "90"
        write "${kernel}sched_downmigrate" "75"
    fi

    # Platform specific CPU tuning
    if [ "$IS_MTK" = "1" ]; then
        write "/sys/module/mtk_core_ctl/parameters/policy_enable" "0"
        write "/sys/kernel/fpsgo/common/fpsgo_enable" "1"
    fi

    if [ "$IS_QCOM" = "1" ]; then
        write "/sys/module/msm_thermal/parameters/enabled" "N"
    fi

    # Set governor to schedutil if available (modern Android default)
    for cpu in /sys/devices/system/cpu/cpu*/cpufreq/; do
        [ ! -d "$cpu" ] && continue
        avail_govs=$(cat "${cpu}scaling_available_governors" 2>/dev/null)
        for gov in schedutil sugov_ext interactive; do
            if echo "$avail_govs" | grep -q "$gov"; then
                write "${cpu}scaling_governor" "$gov"
                break
            fi
        done
    done
    log_i "Tweaked CPU governor ($MOD_PROFILE)"
}

gpu_tune() {
    # Qualcomm Adreno GPU tweaks
    if [ "$IS_QCOM" = "1" ] && [ -d "$gpu" ]; then
        if [ "$MOD_PROFILE" = "performance" ]; then
            write "${gpu}devfreq/adrenoboost" "1"
            write "${gpu}throttling" "0"
        else
            write "${gpu}devfreq/adrenoboost" "0"
            write "${gpu}throttling" "1"
        fi
        log_i "Tweaked Adreno GPU parameters ($MOD_PROFILE)"
    fi
}

schedtune_tune() {
    # Schedtune: Task placement and boosting
    if [ -d "$stune" ]; then
        local fg_boost="1"
        local ta_boost="1"

        if [ "$MOD_PROFILE" = "performance" ]; then
            fg_boost="5"
            ta_boost="10"
        elif [ "$MOD_PROFILE" = "battery" ]; then
            fg_boost="0"
            ta_boost="0"
        fi

        write "${stune}foreground/schedtune.boost" "$fg_boost"
        write "${stune}top-app/schedtune.boost" "$ta_boost"
        log_i "Tweaked Schedtune settings ($MOD_PROFILE)"
    fi
}

disable_crc() {
    # Performance over data integrity: disable CRC check for MMC
    if [ "$MOD_PROFILE" = "performance" ] && [ -d "/sys/module/mmc_core/" ]; then
        write "/sys/module/mmc_core/parameters/crc" "N"
        log_i "Disabled MMC CRC check"
    fi
}

vm_lmk_tune() {
    # Virtual Memory tuning
    write "${vm}dirty_ratio" "20"
    write "${vm}dirty_background_ratio" "5"
    write "${vm}vfs_cache_pressure" "100"
    if [ "$MOD_PROFILE" = "battery" ]; then
        write "${vm}swappiness" "100"
    else
        write "${vm}swappiness" "60"
    fi

    # MGLRU: Greatly improves memory management on modern kernels
    if [ -e "${mm}lru_gen/enabled" ]; then
        write "${mm}lru_gen/enabled" "Y"
    fi

    write "${vm}compaction_proactiveness" "0"

    # KSM (Kernel Samepage Merging): Disable for performance, enable for battery/balance if available
    if [ -e "/sys/kernel/mm/ksm/run" ]; then
        if [ "$MOD_PROFILE" = "performance" ]; then
            write "/sys/kernel/mm/ksm/run" "0"
        else
            write "/sys/kernel/mm/ksm/run" "1"
        fi
    fi

    log_i "Tweaked VM and LMK parameters ($MOD_PROFILE)"
}

config_tcp() {
    # Networking: Choose best congestion control available
    avail_con=$(cat "${tcp_v4}tcp_available_congestion_control" 2>/dev/null)
    for con in bbr bbr2 westwood cubic; do
        if echo "$avail_con" | grep -q "$con"; then
            write "${tcp_v4}tcp_congestion_control" "$con"
            break
        fi
    done

    write "${tcp_v4}tcp_fastopen" "3"
    write "${tcp_v4}tcp_slow_start_after_idle" "0"
    log_i "Applied TCP tweaks"
}

disable_debug() {
    # Disable kernel logging and various debug masks
    write "${kernel}printk" "0 0 0 0"

    # Disable various tracers and statistics to reduce overhead
    write "${kernel}sched_schedstats" "0"
    write "/sys/kernel/debug/tracing/tracing_on" "0"

    log_i "Disabled various debugging features"
}

# Main execution
log_i "Applying AIO tweaks for profile: $MOD_PROFILE"
sync

stop_services
boost_tune
io_tune
cpu_tune
gpu_tune
schedtune_tune
disable_crc
vm_lmk_tune
config_tcp
disable_debug

log_i "AIO tweaks application completed."
