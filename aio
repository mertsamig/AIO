#!/system/bin/sh

klog="/storage/emulated/0/aio/aio.log"
kdbg="/storage/emulated/0/aio/aio_dbg.log"

rm -f "$kdbg" "$klog"

: > "$kdbg"
: > "$klog"

log_i() {
	echo "[$(date +%T)]: [*] $1" >> "$klog"
	echo "" >> "$klog"
}

log_d() {
	echo "$1" >> "$kdbg"
	echo "$1"
}

log_e() {
	echo "[!] $1" >> "$kdbg"
	echo "[!] $1"
}

write() {
    local file="$1"
    local value="$2"
    [[ ! -f "$file" ]] && {
        log_e "$file doesn't exist"
        return 1
    }
    
    if [[ ! -w "$file" ]]; then
        chmod +w "$file" 2>/dev/null || {
            log_e "Cannot make $file writable"
            return 1
        }
    fi
    
    local curval=$(cat "$file" 2>/dev/null)
    [[ "$curval" == "$value" ]] && {
        log_d "$file already set to $value"
        return 0
    }
    
    echo -n "$value" > "$file" 2>/dev/null || {
        log_e "Failed to write $value to $file (current: $curval)"
        return 1
    }
    
    chmod -w "$file" 2>/dev/null
    log_d "$file: $curval -> $value"
}

kill_svc() {
    local svc="$1"
	pid=$(pidof "$svc")
	if [ -n "$pid" ]; then
		kill -15 $pid
		sleep 2
		if kill -0 $pid 2>/dev/null; then
			kill -9 $pid
		fi
	fi
}

